---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const publishers = await getAllPublishers(db);
const categories = Array.from(
  new Map(
    games
      .flatMap((game) => game.category ? [[game.category.id, game.category] as const] : []),
  ).values(),
);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
            <fieldset>
              <legend class="mb-4 text-lg font-semibold text-slate-100">Filter games</legend>
              <div class="grid gap-4 md:grid-cols-2">
                <div>
                  <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">
                    Categories
                  </label>
                  <select
                    id="category-filter"
                    name="categories"
                    multiple
                    class="min-h-28 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    data-testid="category-filter"
                  >
                    {categories.map((category) => (
                      <option value={category?.id}>{category?.name}</option>
                    ))}
                  </select>
                  <p class="mt-1 text-sm text-slate-400">Hold Ctrl or Command to choose multiple.</p>
                </div>
                <div>
                  <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">
                    Publisher
                  </label>
                  <select
                    id="publisher-filter"
                    name="publisher"
                    class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    data-testid="publisher-filter"
                  >
                    <option value="">All publishers</option>
                    {publishers.map((publisher) => (
                      <option value={publisher.id}>{publisher.name}</option>
                    ))}
                  </select>
                </div>
              </div>
              <div class="mt-4 flex items-center gap-4">
                <button
                  type="reset"
                  class="rounded-lg bg-slate-700 px-4 py-2 font-medium text-slate-100 transition-colors hover:bg-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
                  data-testid="reset-filters"
                >
                  Clear filters
                </button>
                <p class="text-sm text-slate-300" aria-live="polite" data-testid="filter-result-count">
                  Showing {games.length} games
                </p>
              </div>
            </fieldset>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="mt-6 hidden" data-testid="filtered-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  if (filterForm && categoryFilter && publisherFilter && resultCount && emptyState) {
    const updateFilters = (): void => {
      const selectedCategories = new Set(
        Array.from(categoryFilter.selectedOptions).map((option) => option.value),
      );
      const selectedPublisher = publisherFilter.value;
      let visibleCount = 0;

      for (const card of gameCards) {
        const matchesCategory =
          selectedCategories.size === 0 ||
          selectedCategories.has(card.dataset.categoryId ?? '');
        const matchesPublisher =
          selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
        const isVisible = matchesCategory && matchesPublisher;

        card.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount += 1;
      }

      resultCount.textContent = `Showing ${visibleCount} game${visibleCount === 1 ? '' : 's'}`;
      emptyState.classList.toggle('hidden', visibleCount !== 0);
    };

    categoryFilter.addEventListener('change', updateFilters);
    publisherFilter.addEventListener('change', updateFilters);
    filterForm.addEventListener('reset', () => {
      requestAnimationFrame(updateFilters);
    });
  }
</script>
